[biometric_sync]
# ERPNext server URL (no trailing slash)
erpnext_url = https://your-erpnext-site.com

# API credentials — generate from:
#   User Settings > API Access > Generate Keys
# The user must have HR Manager role
api_key = your_api_key_here
api_secret = your_api_secret_here

# ZK biometric device settings
device_ip = 192.168.1.201
device_port = 4370

# Device identifier — used to update the Biometric Device record in ERPNext
# Can be the device name or IP as configured in your Biometric Device doctype
device_identifier = 192.168.1.201

# Clear attendance logs from device after successful sync
# Set to true only if this is the sole system reading from the device
clear_after_sync = false
